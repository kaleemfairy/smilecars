# Copy to .env.local for local development, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Public site URL (no trailing slash). Used in WhatsApp admin links, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (server) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Base64-encode the downloaded JSON file and paste it here:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   macOS/Linux: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Storage bucket name, e.g. smilecars-xxxx.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- Firebase (browser, admin sign-in only) ---
# Firebase console > Project settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI chatbot ---
# Server-side only. Leave empty to show "not set up yet" in the chat.
ANTHROPIC_API_KEY=
# Set to "false" to hide the chat widget.
NEXT_PUBLIC_CHAT_ENABLED=true

# --- WhatsApp Business Cloud API (Meta) ---
# Keep "false" until the business is verified and the templates in README are approved.
# While false, messages are only logged.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional: override template names if yours differ.
# WA_TEMPLATE_STAFF_NEW_BOOKING=staff_new_booking
# WA_TEMPLATE_BOOKING_RECEIVED=booking_received
# WA_TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
# WA_TEMPLATE_DELIVERY_DAY=delivery_day

# --- Vercel Cron ---
# Any long random string. Vercel sends it to /api/cron/delivery-reminders.
CRON_SECRET=

# --- Email alerts (Resend, https://resend.com) ---
# New bookings and vehicle enquiries are emailed to the addresses in Admin > Settings.
# Verify smilecars.net in Resend first, then set EMAIL_FROM to an address on it.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Smile Cars Website <bookings@smilecars.net>

# --- Zoho CRM (same Web-to-Lead form as the old site's home page) ---
# Each booking is added to Zoho as a lead (name, phone, email).
ZOHO_ENABLED=false
ZOHO_WEBFORM_XNQSJSDP=5ee9fe25158ed9d73df2c34761f6dc01fc448cc13387c567328a0059fda7c288
ZOHO_WEBFORM_XMIWTLD=7f609ed6cc2eb7521ce09836e42a7a7e3f3f94e8b2f4eb12d53b50a17f80a9d55d52da3ac07713ea59e314aac3
# ZOHO_WEBFORM_URL=https://crm.zoho.in/crm/WebToLeadForm

# --- Google Analytics 4 and Google Ads (IDs from the old site) ---
# Tags load only on the hosts below, so test traffic stays out of the reports.
NEXT_PUBLIC_GA_ID=G-0Q32TJJDTB
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-775830796
# "Outbound click" conversion, fired on call and WhatsApp taps.
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=EiiMCP6F4_kCEIz6-PEC
# Optional: create a "Booking submitted" conversion in Google Ads and paste its label here.
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
NEXT_PUBLIC_TRACKING_HOSTS=smilecars.net,www.smilecars.net
